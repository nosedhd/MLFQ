# ================
# COMPILADOS Y BINARIOS
# ================

# Archivos objeto
*.o
*.obj
*.ko
*.gch

# Ejecutables (sin extensión, .exe, .out)
# Si tu programa se llama "mlfq_simulator", puedes ponerlo explícitamente
mlfq_simulator
*.exe
*.out
*.app

# Librerías estáticas y dinámicas
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.dll.a

# ================
# CARPETAS DE COMPILACIÓN (build, bin, lib)
# ================

# ¡Esto es lo que pediste! Ignora la carpeta bin y build
bin/
build/
cmake-build-debug/
cmake-build-release/
lib/
obj/
Debug/
Release/
*.cache/

# ================
# ARCHIVOS DE MAKEFILE Y COMPILACIÓN
# ================

# Makefile generado (si usas autotools o CMake)
Makefile
Makefile.in
*.mk
cmake_install.cmake
CMakeCache.txt
CMakeFiles/

# ================
# EDITORES Y ENTORNOS (VS Code, Vim, Nano, etc.)
# ================

